<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Background alerts of every server (design doc §9, §10.8). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- S04 step 2 / S84: the app is distributed outside Google Play and its
         15-minute poll is the only alert path until push (v1.1). -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application>
        <!-- T0/T1 actions of the notifications ("Marquer lu", enrolments). -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Quick Settings tile « Astreinte » (design doc §9 #3). -->
        <service
            android:name=".OnCallTileService"
            android:exported="true"
            android:icon="@drawable/notif_ic_oncall"
            android:label="@string/notif_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
