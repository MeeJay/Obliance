# ── Image version (tag Docker Hub, ex: latest, 1.0.0) ──
OBLIANCE_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://obliance:yourpassword@your-db-host:5432/obliance

# ── Server ──
LISTEN_PORT=3003
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-secret

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost


# ── App name (used as prefix in notification messages) ──
APP_NAME=Obliance

# ── Default admin (created on first run) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Monitor limits (admin policy) ──
# Minimum allowed check interval in seconds (default: 10)
# MIN_CHECK_INTERVAL=10
# Minimum allowed retry interval in seconds (default: 5)
# MIN_RETRY_INTERVAL=5

# ── Custom directory (scripts, SSH keys — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obliance/custom
# CUSTOM_DIR=./custom

# ── SSH bastion (ObliJump) — off by default ──
# Lets users reach managed Linux machines with a native `ssh` client, through
# the agent tunnel (no inbound access to the machines). Users register their
# SSH public key in their Obliance profile. To enable:
#   1. set SSH_BASTION_ENABLED=true (and optionally SSH_BASTION_PORT — never 22)
#   2. uncomment the server `ports:` block in docker-compose.yml
# Expose the port DIRECTLY (no TCP proxy): the bastion needs the real client IP
# for its IP allow-list and bans. The IP allow-list is ENFORCED by default:
# add your admin IPs in Settings > SSH bastion, or users authorize their IP
# with the "SSH" button (2FA).
# SSH_BASTION_ENABLED=false
# SSH_BASTION_PORT=2222

# ── Enable Watchtower and define the check interval to keep the containers up to date ──
#COMPOSE_PROFILES=watchtower
#WATCHTOWER_INTERVAL=3600

# ── Client IP behind reverse proxies ────────────────────────────────────────
# Only the X-Forwarded-For entries added by these proxies are believed; the
# client IP is the first address (from the right) that is not one of them.
# Comma-separated IPs, CIDRs or keywords (loopback, linklocal, uniquelocal).
# Default covers the client container's nginx and a reverse proxy (Nginx Proxy
# Manager…) running in Docker on the same host. A proxy on another machine must
# be listed, e.g.: TRUSTED_PROXIES=loopback, 172.16.0.0/12, 192.168.1.10
# Do not use "uniquelocal" if LAN clients can reach the proxy directly.
#TRUSTED_PROXIES=loopback, 172.16.0.0/12
